{
  "name": "easyspeedtest",
  "productName": "EasySpeedTest",
  "version": "1.0.0",
  "description": "Hotkey-driven Wi-Fi speed test surveying for walking a building",
  "main": "src/main/main.js",
  "author": "maxjlaughlin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "postinstall": "node scripts/check-env.js",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maxjlaughlin.easyspeedtest",
    "productName": "EasySpeedTest",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
